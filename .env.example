MAILPIT_URL=https://mailpit.x.x.com
MAILPIT_USERNAME=your-username
MAILPIT_PASSWORD=your-password
# Required; passed to Mailpit's /api/v1/search to scope messages
MAILPIT_SEARCH_QUERY=

# Optional comma-separated allowlist of recipient (To) domains; empty accepts any domain.
# Applied after the Mailpit search, since Mailpit ANDs search terms and cannot OR two domains.
ALLOWED_EMAIL_DOMAINS=mail.yourdomain.com,another.yourdomain.com

# Slack incoming webhook URL (required)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Optional tuning
POLL_INTERVAL_SECONDS=10
OTP_REGEX=\\b\\d{6,8}\\b
MAX_MESSAGES_PER_POLL=20
# Path to sqlite DB storing processed Mailpit message IDs to avoid duplicates
PROCESSED_DB_PATH=db/processed.sqlite
# Log level (panic, fatal, error, warn, info, debug, trace)
LOG_LEVEL=info
